# ==========================================
# Core Django Settings
# ==========================================
DEBUG=False
SECRET_KEY=generate_a_random_secret_key_here
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# ==========================================
# Discord Developer Portal Configuration
# ==========================================
# Create an application at https://discord.com/developers/applications
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=https://yourdomain.com/auth/discord/callback/
DISCORD_BOT_TOKEN=your_bot_token_here

# Target Server & Role Authorization
DISCORD_TARGET_GUILD_ID=your_discord_server_id
DISCORD_GUILD_MEMBER_ROLE_ID=role_id_for_guild_members
DISCORD_ALLIANCE_ROLE_ID=role_id_for_alliance_members
DISCORD_INVITE_URL=https://discord.gg/your-invite-code

# ==========================================
# Google Sheets & Credentials
# ==========================================
GOOGLE_SHEET_ID=your_google_sheet_id_from_url

# Either place 'google_credentials.json' in project root, OR paste the raw JSON string below:
# GOOGLE_CREDENTIALS_JSON='{"type": "service_account", ...}'

# Cache TTLs in seconds
SHEET_CACHE_TTL=300
DISCORD_MEMBERSHIP_CACHE_TTL=60

# ==========================================
# Offline / Local Dev Mock Mode
# ==========================================
# Set to True for offline testing without real Discord or Google Sheets credentials
MOCK_DISCORD_AUTH=False
# Scenario options: allowed, unauthorized_role, not_in_server
MOCK_DISCORD_SCENARIO=allowed
